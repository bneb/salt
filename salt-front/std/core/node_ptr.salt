// core::node_ptr - Safe Pointer Wrapper for Node Allocations
// The "Linus Guardrail": Encapsulates raw addresses with verified null safety.

// NOTE: the legacy `NodePtr<T>` identifier is abolished by the grammar
// (reserved legacy name alongside NativePtr); this module provides the same
// zero-cost, i64-backed node pointer under the name `NodeRef<T>`.

package std.core.node_ptr

import std.core.ptr.Ptr

/// NodeRef<T> - Zero-cost safe pointer wrapper for node-like allocations.
/// Stores the node address as a single i64 for data structures where the
/// node size is known at compile time. Nullity checks are plain compares;
/// conversions lower to ptrtoint/inttoptr with no runtime overhead.
pub struct NodeRef<T> {
    inner: i64  // Raw address stored as integer for zero-cost abstraction
}

impl<T> NodeRef<T> {
    /// Create a null pointer.
    pub fn null() -> NodeRef<T> {
        return NodeRef { inner: 0 };
    }

    /// Check for nullity. Z3 uses this for flow-sensitive analysis.
    pub fn is_null(&self) -> bool {
        return self.inner == 0;
    }

    /// Check for non-nullity (convenience method for conditionals).
    pub fn is_valid(&self) -> bool {
        return self.inner != 0;
    }

    /// Verified Conversion to Reference.
    /// SAFETY: Caller must prove !is_null() via a match or if guard.
    /// The compiler injects Z3 contracts to verify this at compile-time.
    @inline
    pub fn as_ref(&self) -> &T {
        // requires { !self.is_null() }  // Z3 contract - enforced at compile-time
        return self.inner as &T;
    }

    /// Create a NodeRef from an existing reference.
    /// This is the primary constructor when allocating nodes.
    pub fn from_ref(r: &T) -> NodeRef<T> {
        return NodeRef { inner: intrin::ref_to_addr(r) };
    }

    /// Create a NodeRef from a mutable reference.
    pub fn from_mut(r: &mut T) -> NodeRef<T> {
        return NodeRef { inner: intrin::ref_to_addr(r) };
    }

    /// Create a NodeRef from a raw address.
    /// UNSAFE: Caller is responsible for ensuring the address is valid.
    pub fn from_raw(addr: i64) -> NodeRef<T> {
        return NodeRef { inner: addr };
    }

    /// Get the raw address (for interop with C functions or manual pointer math).
    pub fn as_raw(&self) -> i64 {
        return self.inner;
    }

    /// Cast to Ptr<T> for FFI boundaries.
    /// This is the escape hatch when interfacing with C libraries.
    @inline
    pub fn as_ptr(&self) -> Ptr<T> {
        return self.inner as Ptr<T>;
    }
}