package std::linalg

import std.core.ptr.Ptr

// =============================================================================
// std::linalg - Core Linear Algebra
// =============================================================================
// Shape-safe tensor handles remain a compile-time concept (Type::Tensor is
// lowered by the compiler bridge); this module exposes the portable scalar
// kernels over row-major flat buffers. The former `__internal_*` extern
// hooks are gone: identifiers may no longer contain double underscores, and
// no backend arm exists for them in the intrinsic tables.
// =============================================================================

/// (M x N) @ (N x P) -> (M x P), all operands row-major flat buffers.
/// `out` must hold at least m * p elements and must not alias the inputs.
pub fn matmul(
    lhs: Ptr<f32>,
    rhs: Ptr<f32>,
    out: Ptr<f32>,
    m: i64,
    n: i64,
    p: i64,
) {
    // requires { m >= 0 && n >= 0 && p >= 0 }
    unsafe {
        let mut i: i64 = 0;
        while i < m {
            let mut j: i64 = 0;
            while j < p {
                let mut acc: f32 = 0.0;
                let mut k: i64 = 0;
                while k < n {
                    acc = acc + lhs[i * n + k] * rhs[k * p + j];
                    k += 1;
                }
                out[i * p + j] = acc;
                j += 1;
            }
            i += 1;
        }
    }
}

/// Vector addition: out[i] = a[i] + b[i] for i in [0, len).
pub fn vec_add(a: Ptr<f32>, b: Ptr<f32>, out: Ptr<f32>, len: i64) {
    // requires { len >= 0 }
    unsafe {
        let mut i: i64 = 0;
        while i < len {
            out[i] = a[i] + b[i];
            i += 1;
        }
    }
}

/// Dot product of two length-`len` vectors.
pub fn dot(a: Ptr<f32>, b: Ptr<f32>, len: i64) -> f32 {
    // requires { len >= 0 }
    unsafe {
        let mut acc: f32 = 0.0;
        let mut i: i64 = 0;
        while i < len {
            acc = acc + a[i] * b[i];
            i += 1;
        }
        return acc;
    }
}