// Z3 Contract Test: a requires check failing on a havoc'd (loop-mutated)
// argument must suggest adding an `invariant`, not the generic
// requires/assert hints -- and the suggestion must be phrased in the
// CALLER's own terms (the actual argument expression), not the callee's
// parameter name, since the latter is out of scope at the call site.
// Expected: FAIL (verification error) with the AddInvariant hint present,
// substituted correctly, and the generic requires/assert hints absent.
//
// `y` starts from an unconstrained parameter, not a literal, specifically
// so the Houdini-lite candidate this loop shape would otherwise trigger
// (see test_houdini_call_requires_proved.salt) can't survive the base
// case -- `y_init > 0` isn't provable for an arbitrary i64 -- and this
// stays a genuine hard-fail, exercising the diagnostic hint rather than
// being silently solved out from under this test.
package test_havoc_invariant_hint

fn need_positive(y: i64) requires { y > 0 } { }

pub fn f(n: i64, y_init: i64) {
    let mut i: i64 = 0;
    let mut y: i64 = y_init;
    while i < n {
        invariant i >= 0;
        need_positive(y);
        y = y + 1;
        i = i + 1;
    }
}
