// Z3 Contract Test: same mechanism, an unsigned type (u8) -- confirms
// type_min_max's unsigned arms are actually reachable and correct, not
// just the signed i32 path exercised by the other elision fixtures.
// Expected: PASS, no __salt_overflow_panic call emitted.
package test_overflow_elide_unsigned_proved

pub fn safe_add_u8(a: u8, b: u8) -> u8
    requires(a <= 100 && b <= 100)
{ return a + b; }
