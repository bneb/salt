// Z3 Contract Test: a deliberately weakened, genuinely-wrong bound must be
// caught, not compiled in silence.
// Expected: REJECTED at compile time, with the planted bug as the
// counterexample.
//
// This fixture's history is the interesting part. Originally: neither
// verify_postcondition's SatResult::Unknown branch nor its Sat branch's
// "return expression uses an untracked local" sub-case called anything --
// both said "deferred to runtime" in a comment and did nothing. Every
// ensures clause complex enough to time out compiled clean with zero
// enforcement: not proven, not checked at runtime, no warning. Found on a
// real function (kernel/core/syscall_ipc.salt's validate_shm_request in
// KeuOS) where an astronomically wrong bound compiled silently. Fixed by
// adding the missing runtime-check emission, and this fixture -- several
// early-return branches feeding an OR-of-AND postcondition on the last
// one, reliably driving the *old*, wall-clock 100ms Z3 timeout to Unknown
// -- became the regression test for "deferred still means enforced."
//
// Then the compiler's proof budget moved from a 100ms wall-clock timeout
// to a resource-based Z3 rlimit (see the commit that changed the two
// solver_params.set_u32 call sites in verification/mod.rs). Deterministic,
// regardless of machine speed or load -- and, for this specific query,
// generous enough that Z3 now decides it in well under a second rather
// than timing out: it finds the planted bug directly and rejects at
// compile time. That's strictly better than deferring to a runtime check
// that only fires if this exact path executes, so the fixture's outcome
// was updated rather than the query being made artificially harder to
// preserve the original "must defer" premise. Runtime-check emission
// itself still has dedicated coverage: see
// test_ensures_deferred_runtime_check.salt, using a query (bitwise-OR
// monotonicity) that stays genuinely undecided at this same budget.
package test_ensures_timeout_runtime_check

const LIMIT: u64 = 0x0000800000000000;
const PAGE_SIZE: u64 = 4096;

pub fn validate(a: u64, b: u64, n: u64) -> u64
    ensures {
        result != 0 ||
        ((a + n * PAGE_SIZE) <= LIMIT && (b + n * PAGE_SIZE) <= LIMIT)
    }
{
    if a >= LIMIT { return 0 - 1; }
    if b >= LIMIT { return 0 - 1; }
    if (a & 0xFFF) != 0 || (b & 0xFFF) != 0 { return 0 - 1; }
    if n == 0 || n > 16 { return 0 - 1; }
    if (a + n * PAGE_SIZE) < a { return 0 - 1; }
    // Deliberately too permissive: the real check would be `> LIMIT`. This
    // is what a future edit accidentally weakening the bound looks like --
    // exactly the case that must not compile in silence.
    if a >= LIMIT || (a + n * PAGE_SIZE) > LIMIT + 0x1000000000000 { return 0 - 1; }
    if (b + n * PAGE_SIZE) < b { return 0 - 1; }
    if b >= LIMIT || (b + n * PAGE_SIZE) > LIMIT { return 0 - 1; }
    return 0;
}
