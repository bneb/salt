// =============================================================================
// Regression test: StringMap arena must not grow with overwrite count
// =============================================================================
// Guards the fix in StringMap_grow: the replacement arena is sized from the
// bytes surviving compaction plus the insert in flight, not from
// `min_arena` (which is derived from the append-only high-water mark).
//
// Measured arena_cap for one key ("k" -> "VVVVVVVVVV", 11 live bytes),
// overwriting it N times, before and after the fix:
//
//   overwrites | before  | after
//   -----------+---------+--------
//          10  |   1 KiB |  1 KiB
//       1,000  |   4 KiB |  1 KiB
//     100,000  |  44 KiB |  1 KiB
//   1,000,000  | 140 KiB |  1 KiB
//
// Before, arena_cap tracked the write volume; after, it is pinned to the
// 1 KiB rounding floor. Note the arena is always rounded up to 1 KiB, so
// arena_cap/live_bytes has a floor of ~93 for an 11-byte live set and is not
// a useful bound — see check 4.
//
// Requires the StringMap_arena_bytes / StringMap_arena_cap accessors, so this
// test only compiles against std with the fix applied.
// =============================================================================

package main

import std.core.ptr.Ptr
import std.core.str.StringView
import std.collections.string_map.{
    StringMap, StringMap_new, StringMap_set, StringMap_get,
    StringMap_value_at, StringMap_length, StringMap_arena_bytes,
    StringMap_arena_cap, StringMap_live_bytes, StringMap_drop
}

extern fn exit(code: i32);
extern fn puts(s: Ptr<u8>) -> i32;

const KEY: i64 = 1;      // "k"
const VAL: i64 = 10;     // "VVVVVVVVVV"
const LIVE: i64 = KEY + VAL;   // 11 bytes retained by a one-key map

// Overwrite a single key `n` times.
fn hammer(n: i64) -> Ptr<StringMap> {
    let smap = StringMap_new();
    let mut i: i64 = 0;
    while i < n {
        StringMap_set(smap, "k" as StringView, "VVVVVVVVVV" as StringView);
        i = i + 1;
    }
    return smap;
}

pub fn main() -> i32 {
    let few = hammer(10);
    let many = hammer(100000);

    // 1. Data integrity — the fix must not disturb compaction.
    if StringMap_length(few) != 1 { puts("FAIL: few: expected 1 key" as Ptr<u8>); exit(1); }
    if StringMap_length(many) != 1 { puts("FAIL: many: expected 1 key" as Ptr<u8>); exit(1); }
    if StringMap_value_at(many, StringMap_get(many, "k" as StringView)).length() != VAL {
        puts("FAIL: value corrupted after 100000 overwrites" as Ptr<u8>); exit(1);
    }
    if StringMap_value_at(few, StringMap_get(few, "k" as StringView)).length() != VAL {
        puts("FAIL: value corrupted" as Ptr<u8>); exit(1);
    }

    // 2. Live bytes must equal what one key holds, regardless of write count.
    if StringMap_live_bytes(few) != LIVE { puts("FAIL: live_bytes(few)" as Ptr<u8>); exit(1); }
    if StringMap_live_bytes(many) != LIVE { puts("FAIL: live_bytes(many)" as Ptr<u8>); exit(1); }

    // 3. The regression itself: arena_cap must NOT scale with overwrite count.
    //    10 vs 100000 overwrites is a 10,000x difference in writes. Before the
    //    fix arena_cap grew ~44x (1 KiB -> 44 KiB). A 4x ceiling is tight
    //    enough to catch the linear ratchet and loose enough to ignore 1 KiB
    //    rounding.
    let cap_few = StringMap_arena_cap(few);
    let cap_many = StringMap_arena_cap(many);
    if cap_many > cap_few * 4 {
        puts("FAIL: arena_cap scales with overwrite count" as Ptr<u8>); exit(1);
    }

    // 4. The arena must stay near the 1 KiB rounding floor regardless of how
    //    much has been written. 8 KiB is 8x the floor and still 5.5x below the
    //    44 KiB the pre-fix ratchet reaches at 100000 overwrites, so this
    //    catches the regression without pinning the allocator to one page.
    //
    //    This is an absolute ceiling rather than a ratio to live_bytes: the
    //    1 KiB rounding puts a hard floor of ~93x on cap/live for an 11-byte
    //    live set, which makes any small ratio bound unsatisfiable.
    if cap_many > 8192 {
        puts("FAIL: arena_cap exceeds 8 KiB floor ceiling" as Ptr<u8>); exit(1);
    }

    // 5. arena_used must never exceed the allocation.
    if StringMap_arena_bytes(many) > cap_many {
        puts("FAIL: arena_used exceeds arena_cap" as Ptr<u8>); exit(1);
    }

    StringMap_drop(few);
    StringMap_drop(many);

    puts("PASS: StringMap arena does not ratchet with overwrite count" as Ptr<u8>);
    return 0;
}
