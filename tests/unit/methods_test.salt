struct Point {
    x: i32,
    y: i32,
}

impl Point {
    fn distance(self) -> i32 {
        return self.x + self.y;
    }

    fn scale(self, factor: i32) -> i32 {
        return self.x * factor;
    }
}

fn main() {
    let p = Point { x: 10, y: 20 };
    let d = p.distance();
    let s = p.scale(2);
}
